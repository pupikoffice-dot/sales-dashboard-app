{
  "name": "sales-mobile-app",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "verify:supabase": "node ../scripts/verify-supabase.mjs .env",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "android:native": "expo run:android",
    "build:apk": "eas build --platform android --profile preview",
    "android:prebuild": "expo prebuild --platform android",
    "android:apk:debug": "cd android && gradlew.bat assembleDebug",
    "build:apk:local": "expo prebuild --platform android && cd android && gradlew.bat assembleDebug",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-voice/voice": "^3.2.4",
    "@supabase/supabase-js": "^2.43.0",
    "@tanstack/react-query": "^5.35.1",
    "expo": "~51.0.0",
    "expo-application": "~5.9.1",
    "expo-build-properties": "~0.12.3",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.14",
    "expo-secure-store": "~13.0.2",
    "expo-speech": "~13.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "dotenv": "^17.4.0",
    "eas-cli": "^16.28.0",
    "typescript": "^5.3.3"
  }
